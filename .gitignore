.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Streamlit Local Runtime
.streamlit/

# Local task logs & scratch outputs
*.log
scratch/
.system_generated/

# Large model artifacts & local cache (can be regenerated)
data/processed/*.pkl
data/processed/*.tif
